# ---- Tienda ----
# Dirección pública exacta (con https). Se usa para las cookies seguras, el retorno de Wompi y la URL de eventos.
PUBLIC_URL=https://tienda.ejemplo.com

# Administrador inicial. Solo se usa la primera vez que arranca; después puedes borrar ADMIN_PASSWORD de este archivo
# y cambiar la contraseña desde Ajustes.
ADMIN_EMAIL=dueno@ejemplo.com
ADMIN_PASSWORD=

# ---- Cloudflare Tunnel ----
# Token del túnel (Zero Trust > Redes > Túneles > tu túnel > Instalar conector).
TUNNEL_TOKEN=

# ---- Pagos ----
# demo: pasarela simulada, no se cobra nada (valor por defecto).
# wompi: cobros reales con Wompi; requiere las tres llaves de abajo.
PAYMENT_MODE=demo

# ---- Correo ----
# outbox: los correos se guardan en el panel (Correos) y no se envían. El envío real por SMTP está pendiente.
MAIL_TRANSPORT=outbox

# ---- Wompi (solo con PAYMENT_MODE=wompi) ----
# sandbox para pruebas, production para cobrar de verdad.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Minutos que se reserva el inventario de un pago en línea no completado.
RESERVE_MINUTES=45
